from fastapi import FastAPI, HTTPException, Depends, Header
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import RedirectResponse, JSONResponse
from api.service import run_agent_workflow, get_system_health, start_scheduler, stop_scheduler, get_scheduler_status
from api.sqlite_store import SQLiteStore
from api.gmail_auth import get_auth_url, exchange_code_for_tokens, get_credentials, delete_credentials
from api.email_sender import send_email_to_lead, send_test_email, get_email_status
from api.gmail_sync import sync_incoming_emails, get_sync_status
from api.auth import get_auth_url as get_login_url, exchange_code_for_token, verify_token
# from api.nick_api import chat_with_nick, ChatRequest, ChatResponse  # Temporarily disabled - needs langchain-glm
from fastapi.responses import RedirectResponse
from pydantic import BaseModel
from typing import List, Optional
from tools.ems_scraper import EMSScraper
from tools.linkedin_scraper import LinkedInScraper

app = FastAPI(title="Ucymachines AI Orchestration API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ============= AUTHENTICATION =============

class AuthRequest(BaseModel):
    code: str

@app.get('/auth/url')
def get_login_endpoint():
    """Get Google OAuth login URL."""
    try:
        auth_url = get_login_url()
        return {'auth_url': auth_url}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post('/auth/callback')
def auth_callback(request: AuthRequest):
    """Exchange OAuth code for JWT token."""
    try:
        result = exchange_code_for_token(request.code)
        return result
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get('/auth/callback')
def auth_callback_get(code: str):
    """Handle OAuth callback from Google, exchange code, and redirect to frontend."""
    try:
        result = exchange_code_for_token(code)
        if result and result.get('token'):
            # Redirect to frontend with token in URL
            return RedirectResponse(
                url=f"http://localhost:5173/auth/callback?token={result['token']}&email={result['user']['email']}"
            )
        else:
            return RedirectResponse(url="http://localhost:5173/login?error=auth_failed")
    except Exception as e:
        print(f"[Server] Auth callback error: {e}")
        return RedirectResponse(url="http://localhost:5173/login?error=exception")

@app.get('/auth/me')
def get_current_user(authorization: str = Header(None)):
    """Get current authenticated user."""
    if not authorization:
        raise HTTPException(status_code=401, detail="No authorization header")

    try:
        # Extract token from "Bearer <token>"
        token = authorization.replace('Bearer ', '')
        user = verify_token(token)
        return user
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=401, detail="Invalid token")

# ============= PROTECTED ROUTES =============

async def get_user(authorization: str = Header(None)):
    """Dependency to verify auth token."""
    if not authorization:
        raise HTTPException(status_code=401, detail="Not authenticated")

    token = authorization.replace('Bearer ', '')
    return verify_token(token)

class TriggerRequest(BaseModel):
    query: str = "factory closing"

class UpdateLeadRequest(BaseModel):
    status: Optional[str] = None
    outreach_content: Optional[dict] = None

@app.get("/health")
def health_check():
    return get_system_health()

@app.post("/workflow/run")
def run_workflow(request: TriggerRequest):
    try:
        result = run_agent_workflow(request.query)
        return result
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/dashboard/stats")
def get_stats():
    # Get stats from SQLite
    db_stats = SQLiteStore.get_stats()
    return {
        "total_signals": 12840,
        "successful_outreaches": 3120,
        "positive_responses": 452,
        "system_uptime": "99.9%",
        "database": db_stats
    }

@app.get("/dashboard/leads")
def get_leads():
    return SQLiteStore.get_leads()

@app.put("/dashboard/leads/{lead_id}")
def update_lead(lead_id: int, request: UpdateLeadRequest):
    updated_lead = SQLiteStore.update_lead(lead_id, request.dict(exclude_unset=True))
    if not updated_lead:
        raise HTTPException(status_code=404, detail="Lead not found")

    # If lead is being approved, send the email
    if request.status == "APPROVED":
        try:
            # Get the message content
            outreach_content = request.outreach_content or updated_lead.get('outreach_content', {})
            message = outreach_content.get('email_message') or outreach_content.get('linkedin_message')

            if message:
                # Send the email
                email_result = send_email_to_lead(lead_id, message)
                if not email_result.get("success"):
                    print(f"[Server] Failed to send email: {email_result.get('error')}")
                else:
                    print(f"[Server] Email sent successfully: {email_result.get('message_id')}")
        except Exception as e:
            print(f"[Server] Error sending email on approval: {e}")

    return updated_lead

class MessageRequest(BaseModel):
    content: str
    sender: str = "User" # or "AI"

@app.post("/dashboard/leads/{lead_id}/messages")
def add_message(lead_id: int, request: MessageRequest):
    """Add a message to a lead's conversation and optionally send via email."""
    import datetime

    msg = {
        "content": request.content,
        "sender": request.sender,
        "timestamp": datetime.datetime.now().strftime("%I:%M %p"),
        "isAi": False
    }

    # If sender is User, try to send via email
    if request.sender == "User":
        try:
            # Get lead to check if they have an email
            lead = SQLiteStore.get_lead(lead_id)
            if lead and lead.get('contacts') and lead['contacts'][0].get('email'):
                # Send via email
                email_result = send_email_to_lead(lead_id, request.content)
                if email_result.get("success"):
                    msg["email_sent"] = True
                    msg["message_id"] = email_result.get("message_id")
                else:
                    msg["email_sent"] = False
                    msg["email_error"] = email_result.get("error")
        except Exception as e:
            msg["email_sent"] = False
            msg["email_error"] = str(e)

    updated_lead = SQLiteStore.add_message_to_lead(lead_id, msg)
    if not updated_lead:
        raise HTTPException(status_code=404, detail="Lead not found")
    return updated_lead

